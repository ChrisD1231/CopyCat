{
  "name": "copycat",
  "version": "1.0.0",
  "description": "Copy it once. Find it forever.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "keywords": ["clipboard", "productivity", "ai"],
  "author": "Copycat",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.copycat.app",
    "productName": "Copycat",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraFiles": [
      "assets/**"
    ]
  }
}
